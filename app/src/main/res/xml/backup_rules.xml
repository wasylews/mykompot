<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Cached account and session data must never leave the device. -->
    <exclude domain="file" path="datastore/profile.json" />
    <exclude domain="file" path="datastore/session.json" />
    <exclude domain="file" path="datastore/payments.json" />
    <exclude domain="file" path="datastore/tariff_plans.json" />
</full-backup-content>